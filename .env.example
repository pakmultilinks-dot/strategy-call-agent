# ─── Application ──────────────────────────────────────────────────────────────
# Environment: dev | test | production
APP_ENV=dev

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (driver: psycopg2)
# In Docker Compose, use "db" as hostname (the service name)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/strategy_calls

# Docker-compose Postgres init (must match DATABASE_URL credentials)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=strategy_calls

# ─── Webhook ──────────────────────────────────────────────────────────────────
# Shared secret for webhook authentication (Apps Script sends as Bearer token)
# Leave empty to disable in dev mode. MUST be set in production.
WEBHOOK_SECRET=

# Public URL where the webhook is reachable (no trailing slash)
WEBHOOK_PUBLIC_URL=https://your-domain.com

# ─── Dashboard ────────────────────────────────────────────────────────────────
# HTTP Basic auth for the admin dashboard
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Public base URL for the dashboard (password-reset links, etc.)
# Must be reachable from end users - no localhost in production.
DASHBOARD_BASE_URL=https://your-domain.com

# Public base URL for Accept/Decline RSVP links in confirmation emails.
# Must be reachable from end users - no localhost in production.
RSVP_BASE_URL=https://your-domain.com

# ─── Business Timezone ────────────────────────────────────────────────────────
# IANA timezone name - used for reminders, appointment display, scheduler
BUSINESS_TIMEZONE=America/Chicago

# ─── Google OAuth2 (PLATFORM-OWNED - one-click connect) ─────────────────────
# The app owner creates ONE OAuth 2.0 Client ID in Google Cloud Console and
# puts it here.  Every organization then connects with one click:
#   Integrations → "Connect Google" → pick a Google account → approve.
# Organizations NEVER paste credentials - the end user only picks their
# account in the Google popup.  The platform stores each org's own
# refresh token (encrypted) after they connect.
#
# One-time setup: https://console.cloud.google.com → APIs & Services →
# Credentials → Create "OAuth 2.0 Client ID" (type: Web application).
# Add GOOGLE_REDIRECT_URI below to "Authorized redirect URIs" in the console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redirect URI for the OAuth2 callback (must match Google Console configuration)
# Default for local development:
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Refresh token (produced once by: python scripts/authorize_google.py)
# DEPRECATED - Use the OAuth2 Web Application flow (GET /auth/google/start) instead.
# Kept for backward compatibility during migration.
GOOGLE_REFRESH_TOKEN=

# Path to the full token.json file (written by authorize_google.py)
# DEPRECATED - Use the OAuth2 Web Application flow instead.
# Only used as a fallback in development (APP_ENV=dev).
GOOGLE_TOKEN_FILE=token.json

# OAuth state TTL in minutes (CSRF protection). Default: 10 minutes.
GOOGLE_OAUTH_STATE_TTL_MINUTES=10

# Calendar where events are created (use "primary" for default calendar)
CALENDAR_ID=primary

# Gmail sender address (must match the Google account that authorized OAuth)
GMAIL_SENDER=

# ─── Zoom OAuth2 (PLATFORM-OWNED - one-click connect) ─────────────────────────
# The app owner creates ONE OAuth app in the Zoom Marketplace and puts its
# credentials here.  Every organization then connects with one click:
#   Integrations → "Connect Zoom" → sign in to Zoom → Allow.
# Organizations NEVER paste credentials - the end user only authorizes the
# app on zoom.us.  The platform stores each org's own tokens (encrypted)
# after they connect.
#
# One-time setup: https://marketplace.zoom.us → Develop → Build App →
# OAuth → add ZOOM_REDIRECT_URI below to the app's Redirect URL allowlist.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:8000/auth/zoom/callback
ZOOM_OAUTH_STATE_TTL_MINUTES=10

# ─── AI Provider - Primary ────────────────────────────────────────────────────
# OpenAI-compatible endpoint for personalized greeting generation
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ─── AI Provider - Fallback ───────────────────────────────────────────────────
# Tried only if primary exhausts retries. All three must be set.
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Max webhook requests per minute per IP (0 = unlimited)
RATE_LIMIT_PER_MINUTE=30

# ─── Scheduler ────────────────────────────────────────────────────────────────
# Set to "false" in a multi-worker deployment to run scheduler on only one worker
SCHEDULER_ENABLED=true

# ─── JWT Authentication ──────────────────────────────────────────────────────
# Secret key for signing JWTs. MUST be set and at least 32 chars in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Credential Encryption ───────────────────────────────────────────────────
# Fernet key for encrypting customer credentials in org_integrations.
# MUST be set in production. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# ─── Dashboard URL ───────────────────────────────────────────────────────────
# Base URL for password reset links (no trailing slash)
DASHBOARD_BASE_URL=http://localhost:8000

# ─── Credential Encryption (Phase 6B.2) ──────────────────────────────────────
# Fernet key for encrypting customer credentials in the database.
# MUST be set in production. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER commit a real key to version control.
CREDENTIAL_ENCRYPTION_KEY=

# ─── JWT Authentication (Phase 6B.3) ────────────────────────────────────────
# Secret key for signing JWT access tokens.
# MUST be set in production (at least 32 characters). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# NEVER commit a real key to version control.
JWT_SECRET_KEY=

# Access token expiration in minutes (default: 30)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
